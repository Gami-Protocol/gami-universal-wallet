{
  "manifest_version": 3,
  "name": "Gami Wallet",
  "version": "1.0.0",
  "description": "Gami Protocol extension for XP, quests, and rewards.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
